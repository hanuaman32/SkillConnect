APP_NAME=SkillConnect API
ENVIRONMENT=production
DEBUG=false

# Copy the managed PostgreSQL provider's connection URL into the host's secret settings.
# Use the provider's private/internal URL when the API and database share a network.
DATABASE_URL=postgresql+psycopg2://DB_USER:URL_ENCODED_PASSWORD@DB_HOST:5432/DB_NAME

# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS_LONG
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Exact public frontend origin; no trailing slash; comma-separate additional trusted origins.
CORS_ORIGINS=https://your-skillconnect-frontend.example

# Mount persistent storage at /var/data before using this path.
UPLOAD_DIR=/var/data/uploads
MAX_UPLOAD_SIZE_MB=10
