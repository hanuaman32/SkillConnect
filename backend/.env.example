APP_NAME=SkillConnect API
ENVIRONMENT=development
DEBUG=true

# postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME  (must match the root .env used by docker-compose)
DATABASE_URL=postgresql+psycopg2://skillconnect:CHANGE_ME@localhost:5432/skillconnect

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
